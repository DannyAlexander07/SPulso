POSTGRES_DB=spulso
POSTGRES_USER=spulso
POSTGRES_PASSWORD=cambia-esta-clave
DATABASE_URL=postgresql://spulso:cambia-esta-clave@postgres:5432/spulso?schema=public

PORT=3001
TZ=America/Lima
TRUST_PROXY_HOPS=1
WEB_URL=https://app.tu-dominio.com
CORS_ORIGINS=https://app.tu-dominio.com
NEXT_PUBLIC_API_URL=https://api.tu-dominio.com
API_INTERNAL_URL=http://api:3001
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-unico
PRISMA_LOG_QUERIES=false

JSON_BODY_LIMIT=256kb
FORM_BODY_LIMIT=64kb
AUTH_RATE_LIMIT=12
API_RATE_LIMIT=600
SESSION_RATE_LIMIT=120
SELF_ATTENDANCE_RATE_LIMIT=20
SELF_PIN_RATE_LIMIT=10

EXPORT_JOBS_API_WORKER=false
EXPORT_JOBS_WORKER_INTERVAL_MS=500
EXPORT_JOBS_WORKER_BATCH_SIZE=5
EXPORT_JOBS_PROCESSING_TIMEOUT_MS=900000
EXPORT_JOBS_FILE_RETENTION_DAYS=30
EXPORT_JOBS_CLEANUP_INTERVAL_MS=3600000

OBSERVABILITY_TOKEN=cambia-este-token-largo
OBSERVABILITY_METRICS_URL=http://api:3001/health/metrics
EXPORT_ALERT_MAX_PENDING_AGE_MS=600000
EXPORT_ALERT_MAX_FAILED_24H=0
EXPORT_ALERT_MAX_PROCESSING=20

# Valido para una sola VPS porque Docker conserva el volumen api-uploads.
# Para alta disponibilidad cambia a s3 o azure y completa sus credenciales.
FILE_STORAGE_DRIVER=local
FILE_STORAGE_LOCAL_ROOT=uploads

# S3 compatible, valido para Cloudflare R2. Activa con FILE_STORAGE_DRIVER=s3.
FILE_STORAGE_S3_BUCKET=spulso-exportaciones
FILE_STORAGE_S3_REGION=auto
FILE_STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
FILE_STORAGE_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# Azure Blob Storage, usar solo si FILE_STORAGE_DRIVER=azure.
FILE_STORAGE_AZURE_CONNECTION_STRING=...
FILE_STORAGE_AZURE_CONTAINER=exportaciones
