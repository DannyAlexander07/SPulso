{
  "name": "spulso",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm --prefix apps/api run start:dev\" \"npm --prefix apps/web run dev\"",
    "dev:api": "npm --prefix apps/api run start:dev",
    "dev:web": "npm --prefix apps/web run dev",
    "reset:demo": "npm --prefix apps/api run reset:demo",
    "build": "npm --prefix apps/api run build && npm --prefix apps/web run build",
    "build:api": "npm --prefix apps/api run build",
    "build:web": "npm --prefix apps/web run build",
    "lint": "npm --prefix apps/api run lint && npm --prefix apps/web run lint",
    "audit": "npm audit --prefix apps/api && npm audit --prefix apps/web",
    "test:api:load": "npm --prefix apps/api run test:load:exports",
    "test:api:e2e": "npm --prefix apps/api run test:e2e",
    "test:web:e2e": "npm --prefix apps/web run test:e2e",
    "test:e2e": "npm run test:api:e2e && npm run test:web:e2e"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "5.3.0"
    },
    "@hono/node-server": "1.19.17",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "@prisma/dev": {
      "@hono/node-server": "1.19.17",
      "hono": "4.13.3",
      "valibot": "1.4.2"
    },
    "fast-uri": "3.1.5",
    "fast-xml-parser": "5.11.0",
    "eslint": "9.39.5",
    "multer": "2.2.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.23"
  }
}
