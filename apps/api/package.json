{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "worker:exports": "node dist/src/export-jobs.worker",
    "worker:exports:dev": "ts-node src/export-jobs.worker.ts",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "observability:check": "node dist/scripts/check-export-metrics.js",
    "seed": "ts-node prisma/seed.ts",
    "reset:demo": "ts-node prisma/reset-demo.ts",
    "lint": "eslint \"{src,apps,libs,test,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test,scripts}/**/*.ts\" --fix",
    "test": "jest",
    "test:load:exports": "ts-node test/load/export-jobs-load.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node scripts/run-e2e.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1074.0",
    "@azure/storage-blob": "^12.32.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.27",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "debug": "^4.4.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.6.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "5.3.0"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "@prisma/dev": {
      "@hono/node-server": "1.19.17",
      "hono": "4.13.3",
      "valibot": "1.4.2"
    },
    "fast-uri": "3.1.5",
    "fast-xml-parser": "5.11.0",
    "multer": "$multer"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
